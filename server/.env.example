# Copia a .env y completa tus claves
PORT=5000
DB_MODE=json
# DB_MODE=mongo  → requiere MONGODB_URI
MONGODB_URI=mongodb://127.0.0.1:27017/diamante9

# Roboflow (opcional). Sin clave usa detección por modo + OCR local.
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL=baseball-gear
ROBOFLOW_VERSION=1
ROBOFLOW_BASE_URL=https://detect.roboflow.com
